  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser-tests.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["test/browser/**/*.ts"],
  "exclude": []
}
